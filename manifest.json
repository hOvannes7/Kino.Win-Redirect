{
  "manifest_version": 3,
  "name": "Kino.Win Redirect",
  "version": "2.1.0",
  "description": "Adds an «Open on Kinokino» button to Kinopoisk movie and series pages.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Открыть на Kinokino",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.kinopoisk.ru/*"],
      "js": ["scripts/shared.js", "scripts/content.js"],
      "run_at": "document_idle"
    }
  ]
}
